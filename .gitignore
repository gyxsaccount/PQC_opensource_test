# ============================================================================
# .gitignore  --  PQC_opensource_test
# 注意: 以下内容因安全问题或无用性被排除
# ============================================================================

# --- 安全: SSH 私钥 / 证书 ---
*.pem
*.key
*_key
*_key.pub
!*.pub
**/ssh_host_*_key
**/ssh_test_env/host_*

# --- 操作系统 / 编辑器临时文件 ---
Thumbs.db
Desktop.ini
*.tmp
*.swp
*.swo

# --- 构建产物 (git 提交时一般排除) ---
build/
*.o
*.a
*.exe
*.dll
*.lib
*.obj

# --- 构建缓存 / 第三方源码下载 (克隆后用 BUILD.md 重建) ---
demo/downloads/

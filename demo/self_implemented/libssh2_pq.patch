# ============================================================================
# libssh2_pq.patch  --  将后量子算法接入 libssh2 的最小补丁 (概念参考)
#
# 标注: [SELF-IMPLEMENT] — libssh2 官方 (1.11.x) 不含 PQ 算法, 需打补丁。
# 基线: libssh2-1.11.0 源码树
#
# 改动点:
#   1. include/libssh2.h            — 新增算法标识宏
#   2. src/kex.c                    — KEX 协商表注册 "mlkem768x25519-sha256"
#   3. src/kex.h                    — 声明 KEX 方法结构
#   4. src/transport.c              — 混合 KEX 流程接入点
#   5. src/hostkey.c                — 注册 "ssh-ed25519+ml-dsa-44" 主机密钥
#   6. src/crypto.[c|h]             — 后量子密码后端绑定 (OpenSSL 3.5)
#
# 使用: git apply libssh2_pq.patch   (在 libssh2-1.11.0 源码根目录)
# ============================================================================
diff --git a/include/libssh2.h b/include/libssh2.h
--- a/include/libssh2.h
+++ b/include/libssh2.h
@@ -156,6 +156,10 @@ extern "C" {
 /* 后量子混合 KEX 算法名 */
+#define LIBSSH2_KEX_MLKEM768X25519       "mlkem768x25519-sha256"
+#define LIBSSH2_KEX_SNTRUP761X25519      "sntrup761x25519-sha512@openssh.com"
+
+/* 后量子混合主机密钥算法名 */
+#define LIBSSH2_HOSTKEY_ED25519_MLDSA44  "ssh-ed25519+ml-dsa-44"

diff --git a/src/kex.h b/src/kex.h
--- a/src/kex.h
+++ b/src/kex.h
@@ -40,6 +40,9 @@
 /* 后量子 KEX 方法: 客户端 3 个阶段 + 服务端 1 个阶段 */
 int _libssh2_kex_mlkem768x25519(struct _LIBSSH2_KEX *kex,
                                 _libssh2_key_exchange_func_t phase);
+int _libssh2_kex_sntrup761x25519(struct _LIBSSH2_KEX *kex,
+                                 _libssh2_key_exchange_func_t phase);

diff --git a/src/kex.c b/src/kex.c
--- a/src/kex.c
+++ b/src/kex.c
@@ -120,7 +120,11 @@ static const LIBSSH2_KEX_METHOD libssh2_kex_methods[] = {
+  { LIBSSH2_KEX_MLKEM768X25519,
+    &_libssh2_kex_mlkem768x25519 },
+  { LIBSSH2_KEX_SNTRUP761X25519,
+    &_libssh2_kex_sntrup761x25519 },
+  /* 传统算法保持向后兼容 (迁移过渡期必须保留) */
   { "curve25519-sha256",      &_libssh2_kex_method_curve25519_sha256 },
   { "ecdh-sha2-nistp256",     &_libssh2_kex_method_ecdh_sha2_nistp256 },
@@ -158,7 +162,10 @@ static const LIBSSH2_HOSTKEY_METHOD libssh2_hostkey_methods[] = {
+  { LIBSSH2_HOSTKEY_ED25519_MLDSA44,
+    LIBSSH2_HOSTKEY_TYPE_MDSA,  /* 自定义类型 */
+    &_libssh2_hostkey_method_ed25519_mldsa44_sign,
+    &_libssh2_hostkey_method_ed25519_mldsa44_verify },
+  /* 传统算法保持向后兼容 */
   { "ssh-ed25519",
     LIBSSH2_HOSTKEY_TYPE_ED25519,
diff --git a/src/transport.c b/src/transport.c
--- a/src/transport.c
+++ b/src/transport.c
@@ -180,6 +180,12 @@ int _libssh2_transport_send(struct _LIBSSH2_SESSION *session,
 /* KEX_INIT 阶段: 双方 name-list 已交换后, 选择共同算法 */
 static const LIBSSH2_KEX_METHOD *
 choose_kex_method(struct _LIBSSH2_SESSION *session,
                   const unsigned char *client_kex, unsigned long client_len,
                   const unsigned char *server_kex, unsigned long server_len)
 {
   /* ... 现有 name-list 匹配逻辑 ... */
+
+  /* [SELF-IMPLEMENT] 后量子混合算法匹配:
+   *   在普通字符串匹配之前, 先按优先级查找混合算法条目
+   *   (例如 "mlkem768x25519-sha256" 需两端均出现在 name-list 中)
+   *   若服务端只声明传统算法 → 自动回退到 curve25519-sha256 (向后兼容)
+   */
 }

diff --git a/src/crypto.c b/src/crypto.c
--- a/src/crypto.c
+++ b/src/crypto.c
@@ -40,6 +40,11 @@
 #include "openssl.h"
+
+/* [SELF-IMPLEMENT] 后量子密码后端绑定
+ *   编译开关: LIBSSH2_CRYPTO_BACKEND_OPENSSL3PQ
+ *   依赖: OpenSSL >= 3.5.0 (ML-KEM / ML-DSA 原生支持)
+ *   实现: hybrid_kex.c / hybrid_signature.c 中函数
+ *   若链接 liboqs: 在编译时加入 -loqs -loqsprovider
+ */

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -220,6 +220,11 @@ option(BUILD_EXAMPLES "Build examples" ON)
 option(BUILD_TESTING "Build tests" ON)
+
+# [SELF-IMPLEMENT] 后量子选项 (默认 OFF, 打开后启用混合 PQ 算法)
+option(ENABLE_POST_QUANTUM "Enable hybrid post-quantum algorithms (requires OpenSSL 3.5+)" OFF)
+if(ENABLE_POST_QUANTUM)
+  add_compile_definitions(LIBSSH2_ENABLE_POST_QUANTUM)
+  find_package(OpenSSL 3.5 REQUIRED)
+endif()
